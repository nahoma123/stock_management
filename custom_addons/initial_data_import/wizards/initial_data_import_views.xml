<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="initial_data_import_wizard_form" model="ir.ui.view">
        <field name="name">initial.data.import.wizard.form</field>
        <field name="model">initial.data.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Initial Product Data Import">
                <field name="state" invisible="1"/>
                <group invisible="state != 'upload'">
                    <field name="file" filename="filename" options="{'accepted_file_extensions': '.csv,.xlsx'}"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="state != 'upload'">
                    Upload CSV or XLSX with Machine Code, Model Code, Description, Picture 1-4, PRICE ETB,
                    PRICE USD, and STOCK-1 through STOCK-3. The next step previews changes before import.
                </div>
                <field name="line_ids" nolabel="1" invisible="state != 'preview'">
                    <list editable="bottom" decoration-danger="status == 'error'">
                        <field name="include"/>
                        <field name="row_number"/>
                        <field name="machine_code"/>
                        <field name="model_code"/>
                        <field name="description"/>
                        <field name="price_etb"/>
                        <field name="price_usd"/>
                        <field name="stock_1"/>
                        <field name="stock_2"/>
                        <field name="stock_3"/>
                        <field name="status" widget="badge"/>
                        <field name="message" optional="show"/>
                    </list>
                </field>
                <group invisible="state != 'done'">
                    <field name="imported_count" readonly="1"/>
                    <field name="warning_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary" invisible="state != 'preview'"/>
                    <button name="action_reset" string="Choose Another File" type="object" invisible="state == 'upload'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_initial_data_import" model="ir.actions.act_window">
        <field name="name">Initial Product Data Import</field>
        <field name="res_model">initial.data.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_initial_data_import"
              name="Initial Data Import"
              parent="stock.menu_stock_config_settings"
              action="action_initial_data_import"
              groups="stock.group_stock_manager"
              sequence="90"/>
</odoo>
