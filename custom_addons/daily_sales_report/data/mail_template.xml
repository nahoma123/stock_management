<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_daily_sales" model="mail.template">
            <field name="name">Daily Sales Report</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="subject">Daily Sales Report for {{ object.name }}</field>
            <field name="email_to">{{ object.owner_email or object.email or 'admin@example.com' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>Here is the daily sales report for <b><t t-out="object.name"/></b>:</p>
                    <ul>
                        <li><b>Total Orders Confirmed Today:</b> <t t-out="ctx.get('order_count', 0)"/></li>
                        <li><b>Total Sales Amount:</b> <t t-out="ctx.get('total_sales', 0.0)"/> <t t-out="object.currency_id.symbol"/></li>
                    </ul>
                    <p>Great work today!</p>
                    <br/>
                    <p>Best regards,<br/>Odoo Automated System</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
