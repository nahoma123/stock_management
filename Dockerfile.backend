# Stage 1: Build the Go application
FROM golang:1.24-alpine AS builder

# Install git
RUN apk add --no-cache git

# Set the Current Working Directory inside the container
WORKDIR /app

# Copy go.mod and go.sum files
COPY backend/go.mod backend/go.sum ./

# Copy the source code
COPY backend/. .

# Download all dependencies and tidy
ENV GOPROXY=direct
ENV GOSUMDB=off
RUN go mod tidy
RUN go mod download

# Build the Go app as a static binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/server .

# Stage 2: Create the final production image with Odoo dependencies
FROM odoo:18.0

# Switch to root to install packages and set permissions
USER root

# Install postgresql-client which provides 'createdb'
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the pre-built binary from the builder stage
COPY --from=builder /app/server .

# Ensure the binary is executable
RUN chmod +x ./server

# Expose port 8080 for the Go backend
EXPOSE 8080

# Switch back to the odoo user to run the application
USER odoo

# Command to run the executable
CMD ["./server"]
