# We use the locally cached golang:1.21-alpine image to avoid ANY network downloads
FROM golang:1.21-alpine

WORKDIR /app

# Copy the entire backend directory, including the newly created "vendor" folder
COPY backend/. .

# Build the Go application entirely offline using the vendor directory
RUN go build -mod=vendor -o /app/server .

# Expose port 8080 for the Go backend
EXPOSE 8080

# Command to run the executable
CMD ["/app/server"]
